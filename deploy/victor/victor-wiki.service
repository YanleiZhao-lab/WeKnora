[Unit]
Description=victor_wiki full server stack
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target
RequiresMountsFor=/data1/victor_wiki /home/lenovo/victor_wiki/current
[Service]
User=lenovo
SupplementaryGroups=docker
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/lenovo/victor_wiki/current
ExecStart=/usr/bin/bash /home/lenovo/victor_wiki/current/scripts/victor-start.sh
ExecStop=/usr/bin/bash /home/lenovo/victor_wiki/current/scripts/victor-stop.sh
TimeoutStartSec=10min
TimeoutStopSec=3min
[Install]
WantedBy=multi-user.target
